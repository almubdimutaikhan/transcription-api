users
  user_id        UUID          PK
  email          VARCHAR(255)  NOT NULL UNIQUE
  hashed_password TEXT         NOT NULL
  token_balance  INTEGER       NOT NULL DEFAULT 0 CHECK (token_balance >= 0)
  created_at     TIMESTAMPTZ   NOT NULL DEFAULT now()

transcription_jobs
  job_id         UUID          PK
  user_id        UUID          NOT NULL FK → users.user_id ON DELETE CASCADE
  status         VARCHAR(20)   NOT NULL DEFAULT 'pending'
                               CHECK (status IN ('pending','processing','completed','failed'))
  language       VARCHAR(10)   NOT NULL
  file_ext       VARCHAR(10)   NOT NULL
  audio_url      TEXT          NOT NULL
  transcribed_text TEXT        NULL
  priority       INTEGER       NOT NULL DEFAULT 1 CHECK (priority BETWEEN 1 AND 5)
  created_at     TIMESTAMPTZ   NOT NULL DEFAULT now()
  updated_at     TIMESTAMPTZ   NOT NULL DEFAULT now()
  finished_at    TIMESTAMPTZ   NULL
  deleted_at     TIMESTAMPTZ   NULL

audit_logs
  id             UUID          PK
  user_id        UUID          NOT NULL FK → users.user_id ON DELETE CASCADE
  job_id         UUID          NULL FK → transcription_jobs.job_id ON DELETE SET NULL
  action         VARCHAR(50)   NOT NULL
  metadata       JSONB         NULL
  created_at     TIMESTAMPTZ   NOT NULL DEFAULT now()

indexes
  transcription_jobs(user_id)
  transcription_jobs(status)
  transcription_jobs(deleted_at)
  users(email)